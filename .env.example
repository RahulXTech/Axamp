# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your keys stay private.

# Required — API key from https://resend.com (sends the contact form emails)
RESEND_API_KEY=

# Optional — where contact form leads are sent (comma-separate several)
CONTACT_TO_EMAIL=

# Optional — the "from" address, e.g. "AXAMP Website <leads@yourdomain.com>"
# (needs a domain verified in Resend)
CONTACT_FROM_EMAIL=
