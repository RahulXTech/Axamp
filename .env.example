# ─────────────────────────────────────────────────────────────────────
#  AXAMP website — environment settings
#
#  1. Copy this file and name the copy ".env"
#  2. Fill in your values
#  .env is in .gitignore, so your keys are never committed.
#  Full guide: README.md → "Environment variables"
# ─────────────────────────────────────────────────────────────────────

# REQUIRED — Resend API key for the contact form (starts with "re_").
# Get it at https://resend.com → API Keys → Create API Key.
RESEND_API_KEY=

# OPTIONAL — inbox(es) that receive each lead. Separate several with commas.
# Default: info@axamp.com
CONTACT_TO_EMAIL=

# OPTIONAL — sender shown on the lead email, as: Name <address>
# The domain must be verified in Resend first.
# Default: AXAMP Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
